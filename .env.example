VITE_BACKEND_URL=http://127.0.0.1:8000/api/v1
# VITE_BACKEND_URL=https://ymca-of-lagos.onrender.com/api/v1
# Backend production settings (set a unique secret and actual API host/domain).
# DJANGO_SECRET_KEY=generate-a-long-random-secret
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=ymca-of-lagos.onrender.com,api.your-domain.example
# DJANGO_CORS_ALLOWED_ORIGINS=https://ymca-of-lagos.vercel.app,https://your-domain.example
# DJANGO_CORS_ALLOW_ALL_ORIGINS=false
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
#PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxx

# PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: API-based email provider for deployed backend
# Set a verified sender address for either email option.
# DEFAULT_FROM_EMAIL=receipts@ymcaoflagos.org
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# For SMTP instead of Resend, also set EMAIL_HOST, EMAIL_PORT,
# EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, and EMAIL_USE_TLS.

# Remita credentials. Legacy REMITTA_* names are accepted during migration;
# REMITA_* takes precedence. Keep all credentials in the same demo/live environment.
# REMITA_BASE_URL=https://demo.remita.net/remita/exapp/api/v1/send/api
# REMITA_MERCHANT_ID=your_remita_merchant_id
# REMITA_API_KEY=your_remita_api_key
# REMITA_SERVICE_TYPE_ID=your_remita_service_type_id
# REMITA_PUBLIC_KEY=your-public-key-from-remita-dashboard
# Demo membership activation is disabled unless explicitly enabled in DEBUG mode.
# ENABLE_DEMO_MEMBERSHIP=false

# Alternative hosted-link checkout (keep invoice until hosted credentials are ready).
# REMITA_CHECKOUT_MODE=hosted
# REMITA_SECRET_KEY=your-hosted-checkout-secret-key
# REMITA_HOSTED_BASE_URL=https://api-demo.systemspecsng.com/services/connect-gateway/api/v1/payment-engine
# Local preview only; requires DJANGO_DEBUG=true. Never enable for live payments.
# REMITA_LOCAL_TEST_MODE=false
